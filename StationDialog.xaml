<Window x:Class="MetroPlanner.StationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="站点信息" Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="18">
        <DockPanel Margin="0,0,0,8">
            <TextBlock Text="中文名" Width="96" VerticalAlignment="Center"/>
            <TextBox x:Name="NameCnBox"/>
        </DockPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="自动填入英语拼音" Click="AutoEn_Click"/>
            <Button Content="自动填入注音（带声调）" Click="AutoZhuyin_Click" Margin="8,0,0,0"/>
        </StackPanel>
        <DockPanel Margin="0,0,0,8">
            <TextBlock Text="英文名" Width="96" VerticalAlignment="Center"/>
            <TextBox x:Name="NameEnBox"/>
        </DockPanel>
        <DockPanel Margin="0,0,0,8">
            <TextBlock Text="第三语/注音" Width="96" VerticalAlignment="Center"/>
            <TextBox x:Name="NameThirdBox"/>
        </DockPanel>
        <StackPanel Orientation="Horizontal" Margin="96,0,0,10">
            <TextBlock Text="声调：" VerticalAlignment="Center" Foreground="Gray" FontSize="11" Margin="0,0,4,0"/>
            <Button Content="ā" Click="Tone1_Click" Width="30" Margin="0,0,2,0"/>
            <Button Content="á" Click="Tone2_Click" Width="30" Margin="0,0,2,0"/>
            <Button Content="ǎ" Click="Tone3_Click" Width="30" Margin="0,0,2,0"/>
            <Button Content="à" Click="Tone4_Click" Width="30" Margin="0,0,2,0"/>
            <Button Content="ü" Click="Umlaut_Click" Width="30"/>
        </StackPanel>
        <DockPanel Margin="0,0,0,8">
            <TextBlock Text="第三语标签" Width="96" VerticalAlignment="Center"/>
            <TextBox x:Name="ThirdLabelBox"/>
        </DockPanel>
        <CheckBox x:Name="TransferChk" Content="换乘站（属于多条线路时自动判定）" Margin="0,4,0,0"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="OkBtn" Content="保存" Width="84" Margin="0,0,8,0" Click="OkBtn_Click"/>
            <Button x:Name="CancelBtn" Content="取消" Width="84" Click="CancelBtn_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
