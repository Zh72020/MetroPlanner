<Window x:Class="MetroPlanner.ProjectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新建项目" Width="400" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="18">
        <DockPanel Margin="0,0,0,10">
            <TextBlock Text="项目名称" Width="80" VerticalAlignment="Center"/>
            <TextBox x:Name="NameBox" Text="未命名项目"/>
        </DockPanel>
        <DockPanel Margin="0,0,0,10">
            <TextBlock Text="所在城市" Width="80" VerticalAlignment="Center"/>
            <ComboBox x:Name="CityCombo" IsEditable="True" IsTextSearchEnabled="True" StaysOpenOnEdit="True"/>
        </DockPanel>
        <TextBlock Text="提示：选择城市后，项目默认限制在该城市范围内（可在左侧面板「项目」中调整或关闭，以模拟广佛线等跨城线路）。"
                   FontSize="11" Foreground="Gray" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="创建" Width="84" Margin="0,0,8,0" Click="Ok_Click"/>
            <Button Content="取消" Width="84" Click="Cancel_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
